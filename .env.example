# SentryShield — optional configuration
#
# Copy to .env and fill in only what you need. THE APPLICATION RUNS WITHOUT
# THIS FILE. With no credentials it uses the browser's own speech synthesis and
# hides the Bedrock summary; every other feature — live audio, simulation,
# hybrid, replay, the map, the classifier — is unaffected.
#
#   cp .env.example .env
#
# Never commit a real .env. Never paste real keys into a demo repo.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# HTTP port for the command center (default 8000).
PORT=8000
# HTTPS port for the phone (default 8443). Mobile Chrome needs a secure
# context for the microphone, so the QR code points here when key.pem and
# cert.pem exist in the project root.
HTTPS_PORT=8443
# Set to true to silence the server's per-event log lines.
SENTRY_QUIET=false

# ---------------------------------------------------------------------------
# AWS — all optional
# ---------------------------------------------------------------------------
# Region is required for any AWS feature. Without it the adapter reports
# "LOCAL FALLBACK" and the phone speaks with the browser's SpeechSynthesis.
AWS_REGION=ap-south-2

# Static keys. Leave blank to use a shared profile, an SSO session, or an
# instance role instead — the SDK's default credential chain is used, so
# anything it can find works.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only needed for temporary/STS credentials.
AWS_SESSION_TOKEN=

# Use a named profile from ~/.aws/credentials instead of the keys above.
AWS_PROFILE=

# ---------------------------------------------------------------------------
# Amazon Polly — spoken guidance
# ---------------------------------------------------------------------------
# Needs polly:SynthesizeSpeech. Guidance phrases repeat during a scan and are
# cached per session, so a full demo is a handful of calls.
POLLY_VOICE_ID=Matthew
# neural | standard  (neural is clearer; not every voice supports it)
POLLY_ENGINE=neural

# ---------------------------------------------------------------------------
# Amazon Bedrock — optional post-scan interpretation
# ---------------------------------------------------------------------------
# Off by default, and deliberately outside the real-time loop: it runs once
# after a mission, on the numeric summary only, to produce one short paragraph.
# If it is unavailable the mission summary is simply shown without it.
ENABLE_BEDROCK=false
# Needs bedrock:InvokeModel plus model access granted in the Bedrock console.
# Anthropic and Amazon Titan *text* response shapes are handled. Embedding
# models (amazon.titan-embed-*) cannot write text and will not work here.
# Copy the model ID (or the "us."-prefixed inference profile ID) from the
# Bedrock console's model catalog; older model IDs may have been retired.
BEDROCK_MODEL_ID=
# e.g. BEDROCK_MODEL_ID=amazon.titan-text-express-v1

# ---------------------------------------------------------------------------
# Amazon S3 — optional durable copy of finished recordings
# ---------------------------------------------------------------------------
# Recordings are always saved to ./recordings first (replay reads those).
# With a bucket set, each finished scan is also uploaded in the background.
# Needs s3:PutObject on arn:aws:s3:::<bucket>/<prefix>*.
S3_BUCKET=
S3_PREFIX=recordings/

# ---------------------------------------------------------------------------
# EC2 instance role
# ---------------------------------------------------------------------------
# On EC2 with an IAM role attached, leave the keys above blank and set this to
# true. A role leaves no environment variable to detect, so it has to be declared.
AWS_USE_INSTANCE_ROLE=false
